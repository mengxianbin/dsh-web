{
  "name": "dsh-auto-route",
  "version": "0.1.0",
  "description": "Auto source routing for DSH Web: polls OpenCode Go meters (go/status) and, when any window reaches the trigger ratio, programmatically switches the active session set to the MiMo official route (and back when every window recovers). Loopback-fenced status endpoint, host-side only, no npm release — install with `dsh plugin --profile <name> add link:<repo>/packages/dsh-auto-route`.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "license": "Apache-2.0",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
