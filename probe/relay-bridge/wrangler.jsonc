{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dsh-relay-bridge-probe",
  "main": "src/probe.ts",
  "compatibility_date": "2026-08-18",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PROBE_INSTANCE": "shadow-1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE",
        "class_name": "RelayBridge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RelayBridge"
      ]
    }
  ]
}
